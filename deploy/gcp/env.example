# Copy to env.local (do not commit), then: source env.local

# Required
PROJECT_ID="YOUR_PROJECT_ID"
REGION="us-central1"
IMAGE="gcr.io/${PROJECT_ID}/safety-platform:latest"

# Cloud SQL (Postgres)
PG_INSTANCE="safety-platform-pg"
PG_DB="safety_platform"
PG_USER="safety"
PG_PASSWORD="CHANGE_ME"

# Memorystore / Redis
REDIS_HOST="REDIS_HOST_FROM_GCP"
REDIS_PORT="6379"
REDIS_DB="0"

# Optional
SERVICE_API="safety-platform-api"
SERVICE_WORKER="safety-platform-worker"
VPC_CONNECTOR="safety-platform-conn"
QUEUE_NAME="default"

# Auth (optional; leave blank to disable auth)
SAFETY_PLATFORM_API_KEY=""

